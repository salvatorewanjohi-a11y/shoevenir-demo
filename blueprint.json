{
  "$schema": "https://playground.wordpress.net/blueprint-schema.json",
  "landingPage": "/",
  "login": false,
  "preferredVersions": {
    "php": "8.3",
    "wp": "latest"
  },
  "features": {
    "networking": true
  },
  "steps": [
    {
      "step": "installPlugin",
      "pluginData": {
        "resource": "wordpress.org/plugins",
        "slug": "woocommerce"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "installTheme",
      "themeData": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/shoevenir-demo/main/shoevenir.zip"
      },
      "options": {
        "activate": true
      }
    },
    {
      "step": "unzip",
      "zipFile": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/shoevenir-demo/main/images.zip"
      },
      "extractToPath": "/wordpress"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/sv-setup.php",
      "data": {
        "resource": "url",
        "url": "https://raw.githubusercontent.com/salvatorewanjohi-a11y/shoevenir-demo/main/setup.php"
      }
    },
    {
      "step": "mkdir",
      "path": "/wordpress/wp-content/mu-plugins"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/sv-demo.php",
      "data": "<?php\n// Demo: photos are already web-sized, so don't make thumbnails.\nadd_filter( 'woocommerce_resize_images', '__return_false' );\nadd_filter( 'woocommerce_background_image_regeneration', '__return_false' );\n"
    },
    {
      "step": "writeFile",
      "path": "/wordpress/wp-content/mu-plugins/sv-storefront.php",
      "data": "<?php\n// Shop demo link: show the store as a customer sees it.\nadd_filter( 'show_admin_bar', '__return_false' );\n"
    },
    {
      "step": "runPHP",
      "code": "<?php define( 'SV_FAST', true ); require '/wordpress/sv-setup.php';"
    }
  ]
}
